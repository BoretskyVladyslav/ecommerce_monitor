from parsers.base import BaseParser
from parsers.exceptions import SoftBanException, HardBanException
import asyncio
import random
import json
import re
import math
from typing import Optional

class SheinParser(BaseParser):
    
    async def check_for_captcha(self):
        from utils.captcha_detector import captcha_detector
        is_captcha = await captcha_detector.quick_check(self.page, self.marketplace)
        if is_captcha:
            self.logger.warning(f"Captcha detected on {self.marketplace}")
            raise SoftBanException(f"Captcha detected on {self.marketplace}")
    
    async def check_for_ban(self):
        await self.check_for_captcha()
    
    async def detect_risk_challenge(self) -> bool:
        current_url = self.page.url
        if "/risk/challenge" in current_url or "/captcha" in current_url:
            return True
        
        risk_selectors = [
            "[class*='risk']",
            "[class*='challenge']",
            "[class*='security-check']",
            ".geetest_holder",
            "#geetest_holder"
        ]
        
        for selector in risk_selectors:
            try:
                if await self.page.locator(selector).is_visible(timeout=500):
                    return True
            except:
                continue
        
        return False
    
    async def detect_slider_captcha(self) -> bool:
        slider_selectors = [
            ".geetest_slider_button",
            ".geetest_slider",
            "[class*='slider-verify']",
            "#nc_1_n1z",
            ".nc_wrapper",
            "[class*='slide-verify']",
            ".slide-verify-slider"
        ]
        
        for selector in slider_selectors:
            try:
                if await self.page.locator(selector).is_visible(timeout=500):
                    return True
            except:
                continue
        
        return False
    
    async def close_popups(self, aggressive: bool = True, max_attempts: int = 3):
        """
        Enhanced popup closing with multiple passes and cookie consent handling.
        
        Args:
            aggressive: If True, makes multiple passes and waits longer
            max_attempts: Number of times to scan for popups
        """
        # Comprehensive list of popup/overlay selectors
        popup_selectors = [
            # Cookie consent banners
            "#onetrust-accept-btn-handler",
            ".onetrust-close-btn-handler", 
            "button[id*='onetrust']",
            "button[class*='cookie-accept']",
            "button[class*='cookie-consent']",
            "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll",
            ".cookieConsentOK",
            
            # Shein specific popups
            "i.iconfont-close",
            ".iconfont-close",
            ".she-close",
            ".she-modal-close",
            ".sui-modal__close-btn",
            
            # Generic close buttons
            "button[aria-label*='Close' i]",
            "button[aria-label*='close' i]",
            "button[title*='Close' i]",
            "[data-testid='close-button']",
            "[data-testid='modal-close']",
            
            # Dialog/Modal close
            ".dialog-header-v2__close-btn",
            ".popup-dialog-couponPackage .close-btn",
            ".c-coupon-box .iconfont-close",
            ".popup-close",
            ".modal-close",
            "[class*='dialog-close']",
            "[class*='popup-close']",
            "[class*='modal-close']",
            "[data-v-acc1714b] .close-btn",
            "[class*='close-icon']",
            "[class*='closeBtn']",
            "[class*='close-btn']",
            
            # Quick security check overlays
            "[class*='security-check'] button",
            "[class*='verification'] button[class*='close']",
        ]
        
        for attempt in range(max_attempts):
            closed_any = False
            
            for selector in popup_selectors:
                try:
                    locator = self.page.locator(selector).first
                    
                    # Check if visible with a short timeout
                    if await locator.is_visible(timeout=300):
                        self.logger.debug(f"Closing popup: {selector}")
                        
                        # Try to click the close button
                        try:
                            await locator.click(timeout=1500, force=True)
                            closed_any = True
                            await asyncio.sleep(random.uniform(0.3, 0.6))
                        except:
                            # If click fails, try JS click as fallback
                            try:
                                await locator.evaluate("el => el.click()")
                                closed_any = True
                                await asyncio.sleep(random.uniform(0.3, 0.6))
                            except:
                                pass
                                
                except Exception as e:
                    continue
            
            # If we closed something, wait a bit for animations and check again
            if closed_any:
                await asyncio.sleep(random.uniform(0.5, 1.0))
            else:
                # No popups found, we're done
                break
            
            # On aggressive mode, make extra checks
            if not aggressive and attempt >= 1:
                break
        
        # Final wait to ensure page is settled
        if aggressive:
            await asyncio.sleep(random.uniform(0.5, 1.0))
    
    async def dismiss_overlays(self):
        """
        Additional method to handle overlays that aren't closed with buttons.
        Presses ESC key and clicks outside modals.
        """
        try:
            # Press ESC to close any modal dialogs
            await self.page.keyboard.press("Escape")
            await asyncio.sleep(random.uniform(0.3, 0.6))
            
            # Try clicking on backdrop/overlay to dismiss
            backdrop_selectors = [
                ".sui-modal__mask",
                ".modal-backdrop",
                ".overlay",
                "[class*='backdrop']",
                "[class*='mask']"
            ]
            
            for selector in backdrop_selectors:
                try:
                    if await self.page.locator(selector).is_visible(timeout=300):
                        await self.page.locator(selector).click(timeout=1000, force=True)
                        await asyncio.sleep(random.uniform(0.2, 0.4))
                except:
                    continue
                    
        except:
            pass
    
    async def human_mouse_move(self, target_x: float, target_y: float, steps: int = 25):
        """Human-like mouse movement with bezier curve"""
        try:
            current_pos = await self.page.evaluate("() => ({x: window.mouseX || 0, y: window.mouseY || 0})")
            start_x = current_pos.get('x', 0)
            start_y = current_pos.get('y', 0)
            
            for i in range(steps):
                progress = i / steps
                # Smooth easing function
                eased = progress * progress * (3 - 2 * progress)
                
                # Add slight randomness
                noise_x = random.uniform(-3, 3) * (1 - progress)
                noise_y = random.uniform(-3, 3) * (1 - progress)
                
                current_x = start_x + (target_x - start_x) * eased + noise_x
                current_y = start_y + (target_y - start_y) * eased + noise_y
                
                await self.page.mouse.move(current_x, current_y)
                await asyncio.sleep(random.uniform(0.003, 0.012))
            
            # Final precise positioning
            await self.page.mouse.move(target_x, target_y)
            
        except Exception as e:
            self.logger.warning(f"Mouse move failed: {e}")
    
    async def human_click(self, selector: str, force_focus: bool = True):
        """
        Enhanced human-like click with explicit focus handling.
        
        Args:
            selector: CSS selector for the element to click
            force_focus: If True, explicitly sets focus using JS
        """
        try:
            element = self.page.locator(selector).first
            
            # Ensure element is visible
            if not await element.is_visible():
                await element.scroll_into_view_if_needed()
                await asyncio.sleep(random.uniform(0.4, 0.7))
            
            # Get bounding box for precise clicking
            box = await element.bounding_box()
            if not box:
                # Fallback to simple click if no bounding box
                await element.click(force=True)
                if force_focus:
                    await element.focus()
                return
            
            # Calculate target position (slightly randomized within element)
            target_x = box['x'] + box['width'] / 2 + random.uniform(-10, 10)
            target_y = box['y'] + box['height'] / 2 + random.uniform(-10, 10)
            
            # Move mouse to target
            await self.human_mouse_move(target_x, target_y)
            
            # Hover delay (human-like hesitation)
            await asyncio.sleep(random.uniform(0.2, 0.5))
            
            # Perform click with mousedown -> wait -> mouseup pattern
            await self.page.mouse.down()
            await asyncio.sleep(random.uniform(0.05, 0.12))
            await self.page.mouse.up()
            
            # Explicit focus using JavaScript (most reliable)
            if force_focus:
                await asyncio.sleep(random.uniform(0.1, 0.2))
                await element.evaluate("el => el.focus()")
                
                # Verify focus was set
                is_focused = await element.evaluate("el => el === document.activeElement")
                if not is_focused:
                    self.logger.warning(f"Focus not confirmed for {selector}, retrying...")
                    await element.click(force=True)
                    await element.focus()
            
        except Exception as e:
            self.logger.warning(f"Human click failed for {selector}: {e}")
            # Last resort fallback
            try:
                await self.page.locator(selector).first.click(force=True, timeout=2000)
            except:
                pass
    
    async def human_type(self, selector: str, text: str, clear_first: bool = True, validate: bool = True):
        """
        Bulletproof typing with focus validation and fallback mechanisms.
        
        Args:
            selector: CSS selector for input element
            text: Text to type
            clear_first: Whether to clear existing text first
            validate: Whether to validate the typed text
            
        Returns:
            bool: True if typing succeeded, False otherwise
        """
        max_attempts = 3
        
        for attempt in range(max_attempts):
            try:
                self.logger.debug(f"Typing attempt {attempt + 1}/{max_attempts} for {selector}")
                
                element = self.page.locator(selector).first
                
                # Ensure element is visible and in viewport
                if not await element.is_visible():
                    await element.scroll_into_view_if_needed()
                    await asyncio.sleep(random.uniform(0.4, 0.7))
                
                # Wait for element to be ready
                await element.wait_for(state="visible", timeout=5000)
                
                # Clear existing text if requested
                if clear_first:
                    try:
                        # Try triple-click to select all then delete
                        await element.click(click_count=3)
                        await asyncio.sleep(random.uniform(0.1, 0.2))
                        await self.page.keyboard.press("Backspace")
                        await asyncio.sleep(random.uniform(0.1, 0.2))
                    except:
                        pass
                    
                    # Also try clearing via JS
                    try:
                        await element.evaluate("el => el.value = ''")
                    except:
                        pass
                
                # Multiple focus attempts
                focus_success = False
                for focus_attempt in range(3):
                    # Method 1: Human click
                    await self.human_click(selector, force_focus=True)
                    await asyncio.sleep(random.uniform(0.2, 0.4))
                    
                    # Method 2: Direct focus call
                    await element.focus()
                    await asyncio.sleep(random.uniform(0.1, 0.2))
                    
                    # Method 3: JS focus with click event
                    await element.evaluate("""
                        el => {
                            el.focus();
                            el.click();
                            el.dispatchEvent(new Event('focus', { bubbles: true }));
                            el.dispatchEvent(new Event('click', { bubbles: true }));
                        }
                    """)
                    await asyncio.sleep(random.uniform(0.15, 0.3))
                    
                    # Verify focus
                    is_focused = await element.evaluate("el => el === document.activeElement")
                    if is_focused:
                        self.logger.debug(f"Focus confirmed on attempt {focus_attempt + 1}")
                        focus_success = True
                        break
                    else:
                        self.logger.warning(f"Focus not confirmed on attempt {focus_attempt + 1}")
                        await asyncio.sleep(random.uniform(0.3, 0.6))
                
                if not focus_success:
                    self.logger.warning(f"Could not confirm focus after multiple attempts")
                    # Continue anyway, typing might still work
                
                # Type with human-like characteristics
                for i, char in enumerate(text):
                    # Variable typing speed
                    base_delay = random.uniform(0.05, 0.15)
                    
                    # Random longer pauses (thinking)
                    if random.random() < 0.12:
                        base_delay = random.uniform(0.25, 0.5)
                    
                    # Slower for special characters and capitals
                    if char.isupper() or char in "!@#$%^&*()_+-=[]{}|;':\",./<>?":
                        base_delay *= 1.4
                    
                    # Type the character
                    await self.page.keyboard.type(char, delay=base_delay * 1000)
                    
                    # Occasional mid-typing pause
                    if random.random() < 0.08:
                        await asyncio.sleep(random.uniform(0.3, 0.8))
                
                # Final pause after typing
                await asyncio.sleep(random.uniform(0.2, 0.4))
                
                # Validate if requested
                if validate:
                    try:
                        actual_value = await element.input_value()
                        
                        if text in actual_value or actual_value in text:
                            self.logger.info(f"✅ Typing successful: '{actual_value}'")
                            return True
                        else:
                            self.logger.warning(f"⚠️ Typed text mismatch. Expected: '{text}', Got: '{actual_value}'")
                            
                            # If validation failed, try fill() as fallback
                            if attempt < max_attempts - 1:
                                self.logger.info("Retrying with different approach...")
                                continue
                            else:
                                # Last attempt - use fill() method
                                self.logger.info("Using fill() fallback...")
                                await element.fill(text)
                                await asyncio.sleep(random.uniform(0.2, 0.4))
                                
                                # Validate again
                                final_value = await element.input_value()
                                if text in final_value:
                                    self.logger.info(f"✅ Fill fallback successful: '{final_value}'")
                                    return True
                                else:
                                    self.logger.error(f"❌ Fill fallback also failed: '{final_value}'")
                                    return False
                    except Exception as ve:
                        self.logger.warning(f"Validation error: {ve}")
                        # If we can't validate, assume it worked
                        return True
                else:
                    # No validation requested
                    return True
                    
            except Exception as e:
                self.logger.error(f"Typing error on attempt {attempt + 1}: {e}")
                
                if attempt < max_attempts - 1:
                    await asyncio.sleep(random.uniform(0.5, 1.0))
                    continue
                else:
                    # Final fallback - just use fill()
                    try:
                        self.logger.info("Final fallback: using page.fill()...")
                        await self.page.locator(selector).first.fill(text)
                        return True
                    except:
                        return False
        
        return False
    
    async def login(self, email: str, password: str):
        """Enhanced login with robust popup handling"""
        try:
            await self.check_for_captcha()
            
            if await self.detect_risk_challenge():
                self.logger.warning("Risk challenge detected before login")
                raise SoftBanException("Risk challenge page detected")
            
            # CRITICAL: Aggressive popup closing before any interaction
            self.logger.info("Closing popups and overlays...")
            await self.close_popups(aggressive=True, max_attempts=3)
            await self.dismiss_overlays()
            await asyncio.sleep(random.uniform(1.5, 2.5))
            
            # Check and close popups again (they might reappear)
            await self.close_popups(aggressive=False, max_attempts=1)
            
            login_button_selectors = [
                "a[href*='login']",
                "button[aria-label*='Sign']",
                ".she-header-login",
                "[class*='login-btn']",
                "[class*='sign-in']"
            ]
            
            clicked_login = False
            for selector in login_button_selectors:
                try:
                    if await self.page.locator(selector).is_visible(timeout=1000):
                        await self.human_click(selector)
                        clicked_login = True
                        break
                except:
                    continue
            
            if not clicked_login:
                self.logger.warning("Login button not found, assuming already on login page")
            
            await asyncio.sleep(random.uniform(2.5, 4.0))
            
            # Close popups that might appear after navigation
            await self.close_popups(aggressive=True, max_attempts=2)
            
            if await self.detect_slider_captcha():
                self.logger.warning("Slider captcha detected at login page")
                raise SoftBanException("Slider captcha at login")
            
            if await self.detect_risk_challenge():
                self.logger.warning("Risk challenge detected at login page")
                raise SoftBanException("Risk challenge at login")
            
            # Type email with enhanced method
            email_selectors = [
                "input[type='email']",
                "input[name='email']",
                "input[placeholder*='mail' i]",
                "input[placeholder*='Email' i]",
                "#email",
                "[data-testid='email']",
                "input[autocomplete='email']"
            ]
            
            typed_email = False
            for selector in email_selectors:
                try:
                    if await self.page.locator(selector).is_visible(timeout=1000):
                        self.logger.info(f"Attempting to type email in: {selector}")
                        success = await self.human_type(selector, email, clear_first=True, validate=True)
                        if success:
                            typed_email = True
                            break
                        else:
                            self.logger.warning(f"Failed to type in {selector}, trying next selector...")
                except Exception as e:
                    self.logger.warning(f"Error with selector {selector}: {e}")
                    continue
            
            if not typed_email:
                raise Exception("Email field not found or could not type email")
            
            await asyncio.sleep(random.uniform(0.6, 1.2))
            
            # Type password
            password_selectors = [
                "input[type='password']",
                "input[name='password']",
                "#password",
                "[data-testid='password']",
                "input[autocomplete='current-password']"
            ]
            
            typed_password = False
            for selector in password_selectors:
                try:
                    if await self.page.locator(selector).is_visible(timeout=1000):
                        self.logger.info(f"Attempting to type password in: {selector}")
                        success = await self.human_type(selector, password, clear_first=True, validate=False)
                        if success:
                            typed_password = True
                            break
                except Exception as e:
                    self.logger.warning(f"Error with selector {selector}: {e}")
                    continue
            
            if not typed_password:
                raise Exception("Password field not found or could not type password")
            
            await asyncio.sleep(random.uniform(1.2, 2.0))
            
            if await self.detect_slider_captcha():
                self.logger.warning("Slider captcha after credentials")
                raise SoftBanException("Slider captcha after credentials")
            
            # Submit form
            submit_selectors = [
                "button[type='submit']",
                "button[aria-label*='Sign' i]",
                ".she-btn-black",
                "[class*='submit-btn']",
                "[class*='login-btn']"
            ]
            
            try:
                submit_element = None
                for selector in submit_selectors:
                    try:
                        if await self.page.locator(selector).is_visible(timeout=500):
                            submit_element = selector
                            break
                    except:
                        continue
                
                if submit_element:
                    box = await self.page.locator(submit_element).first.bounding_box()
                    if box:
                        random_x = box['x'] + random.uniform(-20, 20)
                        random_y = box['y'] + random.uniform(-20, 20)
                        await self.human_mouse_move(random_x, random_y)
                        await asyncio.sleep(random.uniform(0.4, 0.8))
                    
                    await self.human_click(submit_element)
            except:
                pass
            
            await asyncio.sleep(random.uniform(3.5, 5.5))
            
            if await self.detect_slider_captcha():
                self.logger.warning("Post-login captcha detected")
                raise SoftBanException("Post-login captcha")
            
            if await self.detect_risk_challenge():
                self.logger.warning("Post-login risk challenge")
                raise SoftBanException("Post-login risk challenge")
            
            current_url = self.page.url
            if "/user/auth/login" in current_url:
                raise Exception("Login failed - still on login page")
            
            self.logger.info("Login successful")
            return True
            
        except SoftBanException:
            raise
        except Exception as e:
            self.logger.error(f"Login error: {e}")
            raise
    
    # ... [Rest of the methods remain the same: get_availability_from_js, get_availability_from_json_ld, 
    #      parse, get_product_availability, get_sizes_for_current_color, check_general_availability, get_dom_matrix]
    
    async def get_availability_from_js(self):
        try:
            js_data = None
            for attempt in range(6):
                js_data = await self.page.evaluate("""
                    () => {
                        const data = window.productIntroData || window.gbProductIntroData || window.__INITIAL_STATE__?.product;
                        if (!data) return null;
                        
                        const skuList = data.mainStock?.skuList || data.detail?.skuList || [];
                        const attrList = data.attrSizeList?.sale_attr_list || data.detail?.sale_attr_list || [];
                        
                        if (skuList.length === 0) return null;
                        
                        const attrMap = {};
                        attrList.forEach(attr => {
                            attr.attr_value_list?.forEach(val => {
                                attrMap[val.attr_value_id] = {
                                    name: val.attr_value_name || val.attr_value,
                                    type: attr.attr_name_en || attr.attr_name || 'unknown'
                                };
                            });
                        });
                        
                        return skuList.map(sku => ({
                            sku_id: sku.sku_id || sku.skuId,
                            stock: parseInt(sku.inventory || sku.stock || 0),
                            attributes: sku.skusV2Attributes || sku.sku_sale_attr || [],
                            _attrMap: attrMap
                        }));
                    }
                """)
                
                if js_data and len(js_data) > 0:
                    break
                await asyncio.sleep(0.5)
            
            if not js_data or len(js_data) == 0:
                await self.check_for_captcha()
                return None
            
            variant_matrix = {}
            
            for item in js_data:
                try:
                    attr_map = item.get('_attrMap', {})
                    attributes = item.get('attributes', [])
                    
                    color = "Default"
                    size = "One Size"
                    
                    for attr in attributes:
                        attr_id = attr.get('attr_value_id') or attr.get('attr_id') or str(attr)
                        
                        if str(attr_id) in attr_map:
                            attr_info = attr_map[str(attr_id)]
                            attr_type = attr_info.get('type', '').lower()
                            attr_name = attr_info.get('name', '')
                            
                            if 'color' in attr_type or 'colour' in attr_type:
                                color = attr_name
                            elif 'size' in attr_type:
                                size = attr_name
                            else:
                                if len(attr_name) <= 5 and not color.startswith('Color_'):
                                    size = attr_name
                                else:
                                    color = attr_name
                    
                    stock = item.get('stock', 0)
                    status = 0 if stock > 0 else 2
                    variant_matrix[(color, size)] = status
                    
                except:
                    continue
            
            if len(variant_matrix) > 0:
                return variant_matrix
            
            return None
            
        except:
            return None
    
    async def get_availability_from_json_ld(self):
        try:
            content = await self.page.content()
            pattern = r'<script[^>]*type=["\']application/ld\+json["\'][^>]*>(.*?)</script>'
            json_ld_matches = re.findall(pattern, content, re.DOTALL | re.IGNORECASE)
            
            if not json_ld_matches:
                try:
                    json_ld_matches = await self.page.locator('script[type="application/ld+json"]').all_inner_texts()
                except:
                    pass
            
            if not json_ld_matches:
                await self.check_for_captcha()
                return None
            
            variant_matrix = {}
            current_page_color = None
            
            try:
                color_label = await self.page.locator(".product-intro__color-title, .product-intro__color-radio.selected").first.text_content()
                if color_label:
                    current_page_color = color_label.replace("Color:", "").strip()
            except:
                pass
            
            for i, script_content in enumerate(json_ld_matches):
                try:
                    data = json.loads(script_content)
                    
                    product_group = None
                    if isinstance(data, list):
                        for item in data:
                            if item.get("@type") == "ProductGroup":
                                product_group = item
                                break
                    elif isinstance(data, dict) and data.get("@type") == "ProductGroup":
                        product_group = data
                    
                    if not product_group or "hasVariant" not in product_group:
                        continue
                    
                    group_color = product_group.get("color") or current_page_color
                    
                    for variant in product_group["hasVariant"]:
                        size = variant.get("size")
                        if not size:
                            continue
                        
                        v_color = variant.get("color", group_color)
                        if not v_color:
                            continue
                        
                        offers = variant.get("offers", {})
                        availability = offers.get("availability", "")
                        is_in_stock = 0 if "InStock" in availability else 2
                        variant_matrix[(v_color, size)] = is_in_stock
                
                except:
                    continue
            
            if len(variant_matrix) > 0:
                await self.check_for_captcha()
                return variant_matrix
            
            return None
            
        except:
            return None
    
    async def parse(self, target_color=None, target_size=None):
        try:
            await self.check_for_ban()
            await self.check_for_captcha()
            
            if await self.detect_risk_challenge():
                self.logger.warning("Risk challenge detected")
                raise SoftBanException("Risk challenge detected")
            
            current_url = self.page.url
            if "/user/auth/login" in current_url:
                self.logger.warning("Login redirect detected")
                raise SoftBanException("Login redirect detected")
            
            await self.close_popups()
            
            try:
                await self.wait_for_captcha_or_element(".product-intro", timeout=6)
            except SoftBanException:
                raise
            except:
                pass
            
            await asyncio.sleep(random.uniform(1.0, 2.0))
            
            if await self.detect_slider_captcha():
                self.logger.warning("Slider captcha during parse")
                raise SoftBanException("Slider captcha detected")
            
            availability_result = await self.get_availability_from_json_ld()
            
            matched_status = None
            if availability_result and isinstance(availability_result, dict):
                if target_color or target_size:
                    key = (target_color, target_size)
                    
                    if key in availability_result:
                        matched_status = availability_result[key]
                    else:
                        for (c, s), st in availability_result.items():
                            c_match = c.lower().strip() == target_color.lower().strip() if target_color else True
                            
                            if target_size:
                                s_item = s.lower().strip()
                                s_target = target_size.lower().strip()
                                if len(s_target) <= 3 or len(s_item) <= 3:
                                    s_match = s_item == s_target
                                else:
                                    s_match = s_item == s_target or s_target in s_item
                            else:
                                s_match = True
                            
                            if c_match and s_match:
                                matched_status = st
                                break
                
                if matched_status is not None:
                    return matched_status
                else:
                    availability_result = None
            
            if matched_status is None:
                availability_result = await self.get_product_availability(target_color=target_color)
            
            if isinstance(availability_result, dict) and len(availability_result) > 0:
                if target_color or target_size:
                    key = (target_color, target_size)
                    if key in availability_result:
                        return availability_result[key]
                    
                    for (color, size), status in availability_result.items():
                        color_match = target_color and color.lower().strip() == target_color.lower().strip() if target_color else True
                        
                        if target_size:
                            s_item = size.lower().strip()
                            s_target = target_size.lower().strip()
                            if len(s_target) <= 3 or len(s_item) <= 3:
                                size_match = s_item == s_target
                            else:
                                size_match = s_item == s_target or s_target in s_item
                        else:
                            size_match = True
                        
                        if color_match and size_match:
                            return status
                    
                    return 0
                else:
                    any_in_stock = any(status == 1 for status in availability_result.values())
                    return 1 if any_in_stock else 0
            
            return await self.check_general_availability()
            
        except SoftBanException:
            raise
        except Exception as e:
            raise e
    
    async def get_product_availability(self, target_color=None):
        results = []
        
        try:
            color_container_selector = ".main-sales-attr__color-container .radio-container, .main-sales-attr__color .radio-container"
            color_elements = await self.page.locator(color_container_selector).all()
            
            if not color_elements:
                return await self.get_sizes_for_current_color(None)
            
            found_target = False
            
            for idx, color_element in enumerate(color_elements):
                try:
                    color_name = None
                    try:
                        color_img = color_element.locator("img")
                        color_name = await color_img.get_attribute("alt")
                        if not color_name:
                            color_name = await color_element.get_attribute("aria-label")
                    except:
                        pass
                    
                    if not color_name:
                        try:
                            color_name = await color_element.get_attribute("data-attr_value_name")
                        except:
                            pass
                    
                    if not color_name:
                        try:
                            color_name = await color_element.get_attribute("title")
                        except:
                            pass
                    
                    if not color_name:
                        color_name = f"Color_{idx + 1}"
                    
                    color_name = color_name.strip()
                    if "Color:" in color_name:
                        color_name = color_name.replace("Color:", "").strip()
                    
                    if target_color:
                        c_match = color_name.lower().strip() == target_color.lower().strip() or target_color.lower() in color_name.lower()
                        if not c_match:
                            continue
                        else:
                            found_target = True
                    
                    if not await color_element.is_visible():
                        await color_element.scroll_into_view_if_needed()
                    
                    await color_element.click()
                    
                    try:
                        await self.wait_for_captcha_or_element(".product-intro__size-radio", timeout=random.uniform(2.0, 3.5))
                    except SoftBanException:
                        raise
                    except:
                        pass
                    
                    size_results = await self.get_sizes_for_current_color(color_name)
                    results.extend(size_results)
                    
                    if target_color and found_target:
                        break
                    
                    if idx < len(color_elements) - 1:
                        await asyncio.sleep(random.uniform(1.0, 3.0))
                
                except:
                    continue
            
            return results
            
        except:
            return []
    
    async def get_sizes_for_current_color(self, color_name):
        size_results = []
        
        try:
            size_selector = ".product-intro__size-radio, .product-intro__size-choose .product-intro__size-radio"
            size_elements = await self.page.locator(size_selector).all()
            
            if not size_elements:
                return []
            
            for idx, size_element in enumerate(size_elements):
                try:
                    size_name = None
                    try:
                        size_name = await size_element.get_attribute("data-attr_value_name")
                    except:
                        pass
                    
                    if not size_name:
                        try:
                            size_name = await size_element.get_attribute("data-size-radio")
                        except:
                            pass
                    
                    if not size_name:
                        try:
                            size_name = await size_element.text_content()
                            size_name = size_name.strip() if size_name else None
                        except:
                            pass
                    
                    if not size_name:
                        size_name = f"Size_{idx + 1}"
                    
                    is_disabled = False
                    
                    try:
                        oos_icon = size_element.locator(".out-of-stock-icon")
                        if await oos_icon.is_visible(timeout=200):
                            is_disabled = True
                    except:
                        pass
                    
                    if not is_disabled:
                        try:
                            class_attr = await size_element.get_attribute("class")
                            if class_attr:
                                is_disabled = "disabled" in class_attr or "is-out-of-stock" in class_attr or "out-of-stock" in class_attr
                        except:
                            pass
                    
                    if not is_disabled:
                        try:
                            disabled_attr = await size_element.get_attribute("disabled")
                            is_disabled = disabled_attr is not None
                        except:
                            pass
                    
                    in_stock = 0 if is_disabled else 1
                    
                    size_results.append({
                        "color": color_name,
                        "size": size_name,
                        "in_stock": in_stock
                    })
                    
                except:
                    continue
            
            return size_results
            
        except:
            return []
    
    async def check_general_availability(self):
        try:
            sold_out_class_selectors = [
                ".goods-sold-out",
                ".product-intro__sold-out",
                "[class*='sold-out']"
            ]
            
            for selector in sold_out_class_selectors:
                try:
                    locator = self.page.locator(selector)
                    if await locator.is_visible(timeout=500):
                        return 0
                except:
                    continue
            
            add_to_bag_class_selectors = [
                ".bottom-action__btn",
                ".add-to-bag",
                ".she-btn-black",
                "[class*='add-to-cart']",
                "[class*='add-to-bag']"
            ]
            
            for selector in add_to_bag_class_selectors:
                try:
                    locator = self.page.locator(selector)
                    if await locator.is_visible(timeout=500):
                        is_disabled = await locator.get_attribute("disabled")
                        if is_disabled is not None:
                            return 0
                        return 1
                except:
                    continue
            
            return 0
            
        except:
            return 0
    
    async def get_dom_matrix(self, target_color):
        try:
            await self.check_for_captcha()
            
            selectors = [
                ".main-sales-attr__color-container .radio-container",
                ".main-sales-attr__color .radio-container",
                ".product-intro__color-radio",
                ".product-intro__color-block",
                ".goods-img-item",
                ".color-inner",
                "div[aria-label]"
            ]
            
            color_elements = []
            for sel in selectors:
                elements = await self.page.locator(sel).all()
                if elements:
                    color_elements = elements
                    break
            
            if not color_elements:
                await self.check_for_captcha()
                return None
            
            target_btn = None
            
            for el in color_elements:
                text_sources = []
                
                try:
                    img_alt = await el.locator("img").get_attribute("alt")
                    if img_alt:
                        text_sources.append(img_alt)
                except:
                    pass
                
                try:
                    data_name = await el.get_attribute("data-attr_value_name")
                    if data_name:
                        text_sources.append(data_name)
                except:
                    pass
                
                text_sources.append(await el.get_attribute("aria-label") or "")
                text_sources.append(await el.get_attribute("title") or "")
                text_sources.append(await el.inner_text() or "")
                
                full_text = " ".join([t for t in text_sources if t]).lower()
                full_text = full_text.replace("color:", "").strip()
                
                if target_color.lower() in full_text:
                    target_btn = el
                    break
            
            if not target_btn:
                return None
            
            if not await target_btn.is_visible():
                await target_btn.scroll_into_view_if_needed()
                await asyncio.sleep(random.uniform(0.5, 1.0))
            
            await target_btn.hover()
            await asyncio.sleep(random.uniform(0.3, 0.7))
            await target_btn.click()
            await asyncio.sleep(random.uniform(2.5, 4.0))
            await self.check_for_captcha()
            
            matrix = {}
            
            size_selectors = [
                ".product-intro__size-radio",
                ".product-intro__size-btn",
                ".size-item",
                ".product-intro__size-choose .product-intro__size-radio"
            ]
            
            size_elements = []
            for sel in size_selectors:
                els = await self.page.locator(sel).all()
                if els:
                    size_elements = els
                    break
            
            if not size_elements:
                return None
            
            for size_el in size_elements:
                size_name = await size_el.get_attribute("data-attr_value_name")
                if not size_name:
                    size_name = await size_el.get_attribute("data-size-radio")
                if not size_name:
                    size_name = await size_el.inner_text()
                
                if not size_name:
                    continue
                
                class_attr = await size_el.get_attribute("class") or ""
                
                is_oos = False
                if "disabled" in class_attr.lower() or "out-of-stock" in class_attr.lower():
                    is_oos = True
                
                if not is_oos:
                    if await size_el.get_attribute("disabled"):
                        is_oos = True
                
                status = 2 if is_oos else 0
                clean_size = size_name.split('(')[0].strip()
                matrix[(target_color, clean_size)] = status
            
            return matrix
            
        except:
            return None